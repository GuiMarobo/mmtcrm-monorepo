generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN        // Administrador - privilégios máximos
  VENDEDOR     // Vendedor - negociações, orçamentos, clientes
  ATENDENTE    // Atendente - atendimento e qualificação de leads
  TECNICO      // Técnico - avaliação de dispositivos usados
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum ClientStatus {
  LEAD         // Lead - ainda não qualificado
  ATIVO        // Cliente ativo com negociações
  INATIVO      // Cliente sem atividade recente
}

enum LeadQualification {
  NAO_QUALIFICADO
  QUALIFICADO
  ALTA_INTENCAO  // Alta intenção de compra
}

enum LeadOrigin {
  WHATSAPP
  INSTAGRAM
  SITE
  INDICACAO
  OUTRO
}

model User {
  id          Int     @id @default(autoincrement())
  name        String
  email       String     // unico por indice parcial (WHERE deleted_at IS NULL)
  password    String     // bcrypt
  phone       String?
  role               Role       @default(VENDEDOR)
  status             UserStatus @default(ATIVO)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  anonymizedAt DateTime? @map("anonymized_at")

  negotiations Negotiation[]
  erasuresPerformed DataErasureLog[]
  stockMovements    StockMovement[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Client {
  id              String             @id @default(uuid())
  name            String
  email           String?
  phone           String?
  cpf             String?            // unico por indice parcial (WHERE deleted_at IS NULL)
  address         String?
  status          ClientStatus       @default(LEAD)
  qualification   LeadQualification  @default(NAO_QUALIFICADO)
  origin          LeadOrigin?
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  lastContactAt   DateTime?          @map("last_contact_at")
  deletedAt       DateTime?          @map("deleted_at")
  anonymizedAt    DateTime?          @map("anonymized_at")

  negotiations    Negotiation[]

  @@index([cpf])
  @@index([deletedAt])
  @@map("clients")
}

enum NegotiationStatus {
  ABERTA
  GANHA
  PERDIDA
}

enum OrderStatus {
  EM_NEGOCIACAO
  COMPRA_APROVADA
  DESISTENCIA
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
}

model Negotiation {
  id          Int               @id @default(autoincrement())
  clientId    String            @map("client_id")
  vendedorId  Int?              @map("vendedor_id")
  status      NegotiationStatus @default(ABERTA)
  totalValue  Decimal           @default(0) @map("total_value") @db.Decimal(12, 2)
  notes       String?
  closedAt    DateTime?         @map("closed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendedor User?  @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  order    Order?
  items    NegotiationItem[]

  @@index([clientId])
  @@index([deletedAt])
  @@map("negotiations")
}

model Order {
  id            Int         @id @default(autoincrement())
  negotiationId Int            @unique @map("negotiation_id")
  code          String
  status        OrderStatus    @default(EM_NEGOCIACAO)
  paymentMethod PaymentMethod? @map("payment_method")
  totalValue    Decimal     @default(0) @map("total_value") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  // Marca quando o Pedido entrou na situação atual (RN13). Gravado em convert,
  // approve e reopen. Não usar createdAt (reconversão reaproveita a linha) nem
  // updatedAt. Backfill inicial = updatedAt (um Pedido nunca é editado, só muda
  // de situação — spec 005 §8).
  statusChangedAt DateTime  @default(now()) @map("status_changed_at")
  deletedAt     DateTime?   @map("deleted_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([deletedAt])
  @@map("orders")
}

enum ErasureSubject {
  CLIENTE
  USUARIO
}

enum ErasureAction {
  ELIMINADO
  ANONIMIZADO
}

model DataErasureLog {
  id            Int            @id @default(autoincrement())
  subject       ErasureSubject
  subjectId     String         @map("subject_id")
  subjectLabel  String         @map("subject_label") // rotulo nao identificavel, nunca o nome do titular
  action        ErasureAction
  reason        String?
  performedById Int?           @map("performed_by_id")
  performedAt   DateTime       @default(now()) @map("performed_at")

  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([subject, subjectId])
  @@map("data_erasure_logs")
}

// Catálogo de Produtos (UC6 / spec 009). Os valores de ProductCategory são os
// seis do UC6 §2.1, item 4.
enum ProductCategory {
  IPHONE
  IPAD
  MAC
  APPLE_WATCH
  AUDIO
  ACESSORIOS
}

enum ProductStatus {
  ATIVO
  INATIVO
}

enum StockMovementType {
  ENTRADA
  SAIDA
}

model Product {
  id          String          @id @default(uuid())
  name        String
  sku         String          // unico por indice parcial (WHERE deleted_at IS NULL), gravado normalizado
  description String?
  category    ProductCategory
  price       Decimal         @default(0) @db.Decimal(12, 2)
  // Saldo denormalizado: só muda junto de um StockMovement, na mesma transação
  // (ADR 0013). Nenhum update de produto escreve nesta coluna.
  stock       Int             @default(0)
  status      ProductStatus   @default(ATIVO)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  stockMovements   StockMovement[]
  negotiationItems NegotiationItem[]

  @@index([sku])
  @@index([deletedAt])
  @@map("products")
}

// Um Produto dentro de uma Negociação (spec 010). Guarda a quantidade e o
// preço praticado, copiado do Produto na inclusão e nunca atualizado depois
// (RI4) — mudar o preço no catálogo não retroage nos itens já gravados. Um
// Produto aparece no máximo uma vez por Negociação entre os não excluídos:
// índice único parcial, adicionado à mão na migration (RI3), no mesmo padrão
// de products_sku_unique_active (ADR 0008).
model NegotiationItem {
  id            Int       @id @default(autoincrement())
  negotiationId Int       @map("negotiation_id")
  productId     String    @map("product_id")
  quantity      Int
  unitPrice     Decimal   @map("unit_price") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@index([productId])
  @@index([deletedAt])
  @@map("negotiation_items")
}

// Registro de um fato ocorrido: nunca editado, nunca apagado fisicamente.
model StockMovement {
  id        String            @id @default(uuid())
  productId String            @map("product_id")
  type      StockMovementType
  quantity  Int
  note      String?
  userId    Int?              @map("user_id")
  // Vínculo com o Pedido que originou a baixa/devolução de venda (specs 010/11
  // e 010/14). Nulo no movimento manual. SetNull: o histórico de estoque não
  // pode sumir se o Pedido for excluído (ADR 0013 continua valendo).
  orderId   Int?              @map("order_id")
  createdAt DateTime          @default(now()) @map("created_at")
  deletedAt DateTime?         @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // SetNull preserva o histórico quando o autor é excluído, como Negotiation.vendedorId.
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([deletedAt])
  @@index([orderId])
  @@map("stock_movements")
}
